post_install() {
  if [ -n "${SUDO_USER:-}" ] && [ "$SUDO_USER" != root ]; then
    echo "add $SUDO_USER to the netscope group: sudo usermod -aG netscope $SUDO_USER"
  else
    echo "add your user to the netscope group: sudo usermod -aG netscope <your-user>"
  fi
}

post_upgrade() {
  systemctl try-restart netscoped.service 2>/dev/null || true
}

pre_remove() {
  systemctl disable --now netscoped.service 2>/dev/null || true
  /usr/bin/netscope cleanup --all 2>/dev/null || true
}

post_remove() {
  systemctl daemon-reload
  groupdel netscope 2>/dev/null || true
}
