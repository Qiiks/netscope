[Unit]
Description=netscope per-application network scoping daemon
Documentation=https://github.com/Qiiks/netscope
After=network-pre.target
Wants=network-pre.target

[Service]
Type=exec
ExecStart=/usr/bin/netscoped --foreground
Restart=on-failure
RestartSec=2
TimeoutStopSec=30
User=root
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=RUST_LOG=info
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_NET_ADMIN CAP_SYS_PTRACE
AmbientCapabilities=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
ProtectControlGroups=no
ProtectKernelTunables=yes
# nft_socket may autoload on the first cgroupv2 rule; blocking module load breaks filter/route setup.
ProtectKernelModules=no
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=@system-service @privileged fanotify_init fanotify_mark
RuntimeDirectory=netscope
RuntimeDirectoryMode=0755
StateDirectory=netscope
StateDirectoryMode=0750
ReadWritePaths=-/sys/fs/cgroup/netscope /var/lib/netscope /run/netscope

[Install]
WantedBy=multi-user.target
